<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 通知権限 (Android 13 / API 33 以降) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 位置情報権限 (店舗通知用) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- 端末再起動後のジオフェンス再登録用 (N-6) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".ReceiptReminderApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ジオフェンス進入イベント受信用 Receiver -->
        <receiver
            android:name="geofence.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- 端末再起動後のジオフェンス再登録用 Receiver (G-3, N-6) -->
        <receiver
            android:name="geofence.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
